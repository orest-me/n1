# Copy to .env (or export these) to post to a real Telegram channel.
# With token + chat unset, the bot runs in DRY mode and prints digests to stdout.

# Create a bot with @BotFather and paste its token here:
TELEGRAM_BOT_TOKEN=

# The channel to post to. The bot must be added as an ADMIN of the channel.
# Either a public @username or a numeric chat id (e.g. -1001234567890):
TELEGRAM_CHAT_ID=

# Optional overrides:
RELAY_URL=http://localhost:8787
POST_INTERVAL_MS=15000
# AUTHOR_ID=blake3:...   # defaults to the most active participant on the relay
